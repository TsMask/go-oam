    "version": "0.2.0",
    "configurations": [
        {
            "name": "PUSH-stats",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/examples/push/stats/main.go",
            "cwd": "${workspaceFolder}/examples",
            "console": "integratedTerminal",
            "env": {"GO111MODULE": "on"},
            "args": ["100"]
        },
        {
            "name": "WS-web",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/examples/ws/web/main.go",
            "cwd": "${workspaceFolder}/examples",
            "console": "integratedTerminal",
            "env": {"GO111MODULE": "on"},
            "args": ["--env", "local", "-c", "./local/omc.yaml"]
        }
    ]
}